<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>

<div class="main-content">

  <div class="page-header">
    <div>
      <h4 class="page-title">إعدادات المركز</h4>
      <p class="text-muted small mb-0">بيانات المركز التي تظهر أعلى فاتورة المريض</p>
    </div>
  </div>

  <% if (saved) { %>
  <div class="alert alert-success alert-auto-dismiss shadow-sm">
    <i class="bi bi-check-circle me-2"></i>تم حفظ إعدادات المركز بنجاح
  </div>
  <% } %>

  <% if (pwSaved) { %>
  <div class="alert alert-success alert-auto-dismiss shadow-sm">
    <i class="bi bi-check-circle me-2"></i>تم تغيير كلمة المرور بنجاح
  </div>
  <% } %>

  <% if (pwError) { %>
  <div class="alert alert-danger shadow-sm">
    <i class="bi bi-exclamation-triangle me-2"></i><%= pwError %>
  </div>
  <% } %>

  <form method="POST" action="/settings" class="card shadow-sm" id="settingsForm">
    <div class="card-body">
      <div class="row g-4">

        <!-- Logo -->
        <div class="col-md-4">
          <label class="form-label fw-500">شعار المركز</label>
          <div class="text-center border rounded p-3 mb-2" style="background:#fff;min-height:170px">
            <div id="logoPlaceholder" class="text-muted <%= settings.lab_logo ? 'd-none' : '' %>">
              <i class="bi bi-image" style="font-size:40px"></i>
              <div class="small mt-1">لا يوجد شعار</div>
            </div>
            <img id="logoPreview" src="<%= settings.lab_logo || '' %>" alt="الشعار"
                 class="img-fluid <%= settings.lab_logo ? '' : 'd-none' %>"
                 style="max-height:140px;max-width:100%">
          </div>
          <input class="form-control form-control-sm" type="file" id="logoFile" accept="image/*">
          <input type="hidden" name="lab_logo" id="logoData">
          <% if (settings.lab_logo) { %>
          <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" name="remove_logo" value="1" id="removeLogo">
            <label class="form-check-label small text-danger" for="removeLogo">حذف الشعار الحالي</label>
          </div>
          <% } %>
          <div class="form-text">صيغ مدعومة: PNG، JPG، WEBP (حتى 1.5MB)</div>
        </div>

        <!-- Fields -->
        <div class="col-md-8">
          <div class="mb-3">
            <label class="form-label fw-500">اسم المركز <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="lab_name" id="inpName"
                   value="<%= settings.lab_name %>" required placeholder="مثال: مركز النور للتحاليل">
          </div>
          <div class="mb-3">
            <label class="form-label fw-500">العنوان</label>
            <input type="text" class="form-control" name="lab_address" id="inpAddress"
                   value="<%= settings.lab_address %>" placeholder="عنوان المركز">
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-500">رقم الهاتف</label>
              <input type="text" class="form-control" name="lab_phone" id="inpPhone"
                     value="<%= settings.lab_phone %>" placeholder="01xxxxxxxxx" dir="ltr">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-500">رقم هاتف إضافي</label>
              <input type="text" class="form-control" name="lab_phone2" id="inpPhone2"
                     value="<%= settings.lab_phone2 %>" placeholder="اختياري" dir="ltr">
            </div>
          </div>
        </div>
      </div>

      <!-- Invoice preview -->
      <div class="mt-4 p-3 rounded" style="background:#fff;border:1px dashed #dee2e6">
        <div class="small text-muted mb-2"><i class="bi bi-eye me-1"></i>معاينة رأس الفاتورة</div>
        <div class="d-flex align-items-start gap-3">
          <div class="lab-logo" id="pvLogo">
            <% if (settings.lab_logo) { %>
              <img src="<%= settings.lab_logo %>" alt="الشعار">
            <% } else { %>
              <i class="bi bi-activity"></i>
            <% } %>
          </div>
          <div>
            <div class="lab-name" id="pvName"><%= settings.lab_name || '' %></div>
            <div class="lab-sub" id="pvAddress"><%= settings.lab_address || '' %></div>
            <div class="lab-sub" id="pvPhone">هاتف: <%= settings.lab_phone %><% if (settings.lab_phone2) { %> / <%= settings.lab_phone2 %><% } %></div>
          </div>
        </div>
      </div>
    </div>

    <div class="card-footer bg-white">
      <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-circle me-1"></i>حفظ الإعدادات
      </button>
    </div>
  </form>

  <!-- تغيير كلمة المرور -->
  <div class="card shadow-sm mt-4" id="passwordCard">
    <div class="card-header bg-white">
      <h6 class="mb-0"><i class="bi bi-shield-lock me-2 text-primary"></i>تغيير كلمة مرور المستخدم</h6>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label fw-500">كلمة المرور الحالية</label>
          <input type="password" class="form-control" name="current_password" id="inpCurrentPass"
                 autocomplete="current-password" required>
        </div>
        <div class="col-md-4">
          <label class="form-label fw-500">كلمة المرور الجديدة</label>
          <input type="password" class="form-control" name="new_password" id="inpNewPass"
                 minlength="5" autocomplete="new-password" required>
          <div class="form-text">5 أحرف على الأقل</div>
        </div>
        <div class="col-md-4">
          <label class="form-label fw-500">تأكيد كلمة المرور</label>
          <input type="password" class="form-control" name="confirm_password" id="inpConfirmPass"
                 autocomplete="new-password" required>
        </div>
      </div>
      <div class="invalid-feedback" id="pwFeedback" style="display:none"></div>
    </div>
    <div class="card-footer bg-white">
      <button type="button" class="btn btn-primary" id="btnChangePass">
        <i class="bi bi-key me-1"></i>تغيير كلمة المرور
      </button>
    </div>
  </div>

</div><!-- /main-content -->

<script>
  const logoFile = document.getElementById('logoFile');
  const logoData = document.getElementById('logoData');
  const logoPreview = document.getElementById('logoPreview');
  const logoPlaceholder = document.getElementById('logoPlaceholder');
  const removeLogo = document.getElementById('removeLogo');
  const pvLogo = document.getElementById('pvLogo');

  function updateLogoBox() {
    if (logoData.value) {
      logoPreview.src = logoData.value;
      logoPreview.classList.remove('d-none');
      logoPlaceholder.classList.add('d-none');
      if (pvLogo) pvLogo.innerHTML = '<img src="' + logoData.value + '" alt="الشعار">';
    }
  }

  if (logoFile) {
    logoFile.addEventListener('change', () => {
      const file = logoFile.files[0];
      if (!file) return;
      if (file.size > 1.5 * 1024 * 1024) {
        alert('حجم الصورة كبير جداً. اختر صورة أقل من 1.5MB');
        logoFile.value = '';
        return;
      }
      const reader = new FileReader();
      reader.onload = () => {
        logoData.value = reader.result;
        updateLogoBox();
      };
      reader.readAsDataURL(file);
    });

    if (removeLogo) {
      removeLogo.addEventListener('change', () => {
        if (removeLogo.checked) {
          logoData.value = '';
          logoPreview.classList.add('d-none');
          logoPreview.src = '';
          logoPlaceholder.classList.remove('d-none');
          if (pvLogo) pvLogo.innerHTML = '<i class="bi bi-activity"></i>';
        } else {
          updateLogoBox();
        }
      });
    }
  }

  function bindLive(elId, pvId) {
    const el = document.getElementById(elId);
    const pv = document.getElementById(pvId);
    if (el && pv) el.addEventListener('input', () => { pv.textContent = el.value; });
  }
  bindLive('inpName', 'pvName');
  bindLive('inpAddress', 'pvAddress');
  const inpPhone = document.getElementById('inpPhone');
  const inpPhone2 = document.getElementById('inpPhone2');
  function updatePvPhone() {
    const p = document.getElementById('pvPhone');
    let t = 'هاتف: ' + (inpPhone.value || '');
    if (inpPhone2 && inpPhone2.value) t += ' / ' + inpPhone2.value;
    p.textContent = t;
  }
  inpPhone.addEventListener('input', updatePvPhone);
  if (inpPhone2) inpPhone2.addEventListener('input', updatePvPhone);

  // تغيير كلمة المرور عبر fetch (بدون إعادة تحميل الصفحة)
  const btnChangePass = document.getElementById('btnChangePass');
  const pwFeedback = document.getElementById('pwFeedback');
  if (btnChangePass) {
    btnChangePass.addEventListener('click', async () => {
      const currentPassword = document.getElementById('inpCurrentPass').value;
      const newPassword = document.getElementById('inpNewPass').value;
      const confirmPassword = document.getElementById('inpConfirmPass').value;

      pwFeedback.style.display = 'none';

      if (!currentPassword || !newPassword || !confirmPassword) {
        pwFeedback.textContent = 'ادخل جميع الحقول';
        pwFeedback.style.display = 'block';
        return;
      }
      if (newPassword.length < 5) {
        pwFeedback.textContent = 'كلمة المرور الجديدة يجب ألا تقل عن 5 أحرف';
        pwFeedback.style.display = 'block';
        return;
      }
      if (newPassword !== confirmPassword) {
        pwFeedback.textContent = 'كلمتا المرور غير متطابقتين';
        pwFeedback.style.display = 'block';
        return;
      }

      btnChangePass.disabled = true;
      try {
        const resp = await fetch('/settings/password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ current_password: currentPassword, new_password: newPassword, confirm_password: confirmPassword }),
        });
        if (resp.redirected) {
          window.location.href = resp.url;
          return;
        }
        const data = await resp.json();
        pwFeedback.className = 'invalid-feedback';
        pwFeedback.style.display = 'block';
        pwFeedback.textContent = data.error || 'حدث خطأ أثناء تغيير كلمة المرور';
      } catch (err) {
        pwFeedback.style.display = 'block';
        pwFeedback.textContent = 'حدث خطأ أثناء تغيير كلمة المرور';
      } finally {
        btnChangePass.disabled = false;
        document.getElementById('inpCurrentPass').value = '';
        document.getElementById('inpNewPass').value = '';
        document.getElementById('inpConfirmPass').value = '';
      }
    });
  }
</script>

<%- include('../partials/footer') %>