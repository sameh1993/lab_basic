<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>

<%
  const fmt = (n) => parseFloat(n).toLocaleString('ar-EG');
%>

<div class="main-content">

  <div class="page-header">
    <div>
      <h4 class="page-title">تقرير الربح والخسارة</h4>
      <p class="text-muted small mb-0">
        الإيرادات − تكلفة التحاليل − المصروفات
      </p>
    </div>
    <a href="/reports" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-calendar-month me-1"></i>هذا الشهر
    </a>
  </div>

  <!-- Date filter -->
  <form method="GET" action="/reports" class="card shadow-sm mb-4">
    <div class="card-body py-3">
      <div class="row g-2 align-items-end">
        <div class="col-md-4">
          <label class="form-label fw-500 small mb-1">من تاريخ</label>
          <input type="date" name="from" class="form-control form-control-sm" value="<%= from %>">
        </div>
        <div class="col-md-4">
          <label class="form-label fw-500 small mb-1">إلى تاريخ</label>
          <input type="date" name="to" class="form-control form-control-sm" value="<%= to %>">
        </div>
        <div class="col-md-4">
          <button type="submit" class="btn btn-sm btn-primary w-100">
            <i class="bi bi-funnel me-1"></i>تصفية
          </button>
        </div>
      </div>
    </div>
  </form>



  <!-- Summary cards -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="stat-card">
        <div class="stat-icon bg-success-subtle text-success">
          <i class="bi bi-cash-stack"></i>
        </div>
        <div class="stat-value"><%= fmt(revenue) %> ج.م</div>
        <div class="stat-label">الإيرادات (قيمة الفواتير)</div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="stat-card">
        <div class="stat-icon bg-danger-subtle text-danger">
          <i class="bi bi-box-seam"></i>
        </div>
        <div class="stat-value"><%= fmt(costOfTests) %> ج.م</div>
        <div class="stat-label">تكلفة التحاليل</div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="stat-card">
        <div class="stat-icon bg-warning-subtle text-warning">
          <i class="bi bi-receipt-cutoff"></i>
        </div>
        <div class="stat-value"><%= fmt(expensesTotal) %> ج.م</div>
        <div class="stat-label">المصروفات</div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="stat-card">
        <div class="stat-icon <%= netProfit >= 0 ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' %>">
          <i class="bi <%= netProfit >= 0 ? 'bi-graph-up-arrow' : 'bi-graph-down-arrow' %>"></i>
        </div>
        <div class="stat-value <%= netProfit >= 0 ? 'text-success' : 'text-danger' %>"><%= fmt(netProfit) %> ج.م</div>
        <div class="stat-label"><%= netProfit >= 0 ? 'صافي الربح' : 'صافي الخسارة' %></div>
      </div>
    </div>
  </div>

  <!-- الربح الإجمالي + المدفوع -->
  <div class="row g-3 mb-4">
    <div class="col-lg-6">
      <div class="card shadow-sm h-100">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <div class="text-muted small">الربح الإجمالي (الإيرادات − التكلفة)</div>
            <div class="fs-4 fw-700 <%= grossProfit >= 0 ? 'text-success' : 'text-danger' %>"><%= fmt(grossProfit) %> ج.م</div>
          </div>
          <div class="text-end">
            <div class="text-muted small">المدفوع فعلياً</div>
            <div class="fs-5 fw-600 text-primary"><%= fmt(cashReceived) %> ج.م</div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-6">
      <div class="alert alert-light border mb-0 h-100 d-flex align-items-center">
        <i class="bi bi-lightbulb fs-4 text-warning me-3"></i>
        <div class="small text-muted">
          صافي الربح = الإيرادات − تكلفة التحاليل − المصروفات<br>
          التكلفة تُحسب من حقل «التكلفة» في كتالوج التحاليل عند إنشاء الفاتورة.
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3">

    <!-- Invoices breakdown -->
    <div class="col-lg-7">
      <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h6 class="mb-0"><i class="bi bi-receipt me-2"></i>فواتير الفترة (<%= invoices.length %>)</h6>
        </div>
        <div class="card-body p-0">
          <% if (invoices.length === 0) { %>
            <div class="text-center py-5 text-muted">
              <i class="bi bi-inbox fs-1 d-block mb-2"></i>
              لا توجد فواتير في هذه الفترة
            </div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>#</th>
                  <th>الفاتورة / المريض</th>
                  <th>الإيراد</th>
                  <th>التكلفة</th>
                  <th>الربح</th>
                </tr>
              </thead>
              <tbody>
                <% invoices.forEach((inv, i) => {
                     const p = parseFloat(inv.total_amount) - parseFloat(inv.items_cost);
                %>
                <tr>
                  <td class="text-muted"><%= i + 1 %></td>
                  <td>
                    <a href="/invoices/<%= inv.id %>" class="fw-500 text-primary text-decoration-none"><%= inv.invoice_number %></a>
                    <div class="text-muted small"><%= inv.patient_name %> · <%= new Date(inv.created_at).toLocaleDateString('ar-EG') %> · <%= inv.item_count %> تحليل</div>
                  </td>
                  <td class="fw-500"><%= fmt(inv.total_amount) %> ج.م</td>
                  <td class="text-secondary"><%= fmt(inv.items_cost) %> ج.م</td>
                  <td class="fw-600 <%= p >= 0 ? 'text-success' : 'text-danger' %>"><%= fmt(p) %> ج.م</td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Expenses -->
    <div class="col-lg-5">
      <div class="card shadow-sm">
        <div class="card-header">
          <h6 class="mb-0"><i class="bi bi-receipt-cutoff me-2"></i>المصروفات</h6>
        </div>
        <div class="card-body">
          <form method="POST" action="/reports/expenses" class="row g-2 mb-3">
            <input type="hidden" name="from" value="<%= from %>">
            <input type="hidden" name="to" value="<%= to %>">
            <div class="col-12">
              <input type="text" name="description" class="form-control form-control-sm"
                     placeholder="وصف المصروف (مثال: كيماويات)" required>
            </div>
            <div class="col-6">
              <input type="number" name="amount" class="form-control form-control-sm"
                     placeholder="المبلغ" min="0.5" step="0.5" required>
            </div>
            <div class="col-6">
              <input type="text" name="category" class="form-control form-control-sm"
                     list="expCatList" placeholder="التصنيف">
              <datalist id="expCatList">
                <option value="كيماويات"><option value="إيجار"><option value="رواتب">
                <option value="صيانة"><option value="كهرباء"><option value="مياه">
                <option value="أخرى">
              </datalist>
            </div>
            <div class="col-12">
              <input type="date" name="expense_date" class="form-control form-control-sm" value="<%= to %>">
            </div>
            <div class="col-12">
              <button type="submit" class="btn btn-sm btn-success w-100">
                <i class="bi bi-plus-lg me-1"></i>إضافة مصروف
              </button>
            </div>
          </form>

          <% if (expenses.length === 0) { %>
            <div class="text-center py-4 text-muted small">لا توجد مصروفات في هذه الفترة</div>
          <% } else { %>
          <div class="table-responsive" style="max-height:360px">
            <table class="table table-sm align-middle mb-0">
              <thead class="table-light">
                <tr><th>الوصف</th><th>التصنيف</th><th>المبلغ</th><th>التاريخ</th><th></th></tr>
              </thead>
              <tbody>
                <% expenses.forEach(e => { %>
                <tr>
                  <td class="fw-500 small"><%= e.description %></td>
                  <td><span class="badge bg-secondary-subtle text-secondary small"><%= e.category %></span></td>
                  <td class="text-danger fw-600 small"><%= fmt(e.amount) %> ج.م</td>
                  <td class="text-muted small"><%= new Date(e.created_at).toLocaleDateString('ar-EG') %></td>
                  <td>
                    <form action="/reports/expenses/<%= e.id %>?_method=DELETE&return=/reports?from=<%= from %>%26to=<%= to %>"
                          method="POST" onsubmit="return confirm('حذف هذا المصروف؟')">
                      <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-1"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>
      </div>
    </div>

  </div>

</div><!-- /main-content -->

<%- include('../partials/footer') %>